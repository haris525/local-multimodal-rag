# Copy to .env and adjust. Every setting has a working default.
# Apple Silicon: docs/MACOS.md; always launch with scripts/macos.py. MAC_MODELS_DIR and MAC_LLM_CTX
# are shell variables for that helper, not settings to put here. Native inference memory is outside Docker.
# What each setting changes: docs/DEPLOYMENT.md, section 2.3. After editing .env, run: docker compose up -d

# Never put keys, passwords or tokens here: .env is passed to every service. Keys live in secrets/
# (scripts/init_secrets.py); API tokens for the smoke tests, evaluation and benchmarks go in the shell (RAG_TOKEN,
# EVAL_TOKEN).
# The benchmark (uv run --project eval python -m rag_eval bench ...) runs on the host and reads only the shell:
#   RAG_TOKEN       the benchmark account's API token (required; EVAL_TOKEN also works)
#   EVAL_URL        gateway API base (default http://localhost:8000/api)
#   EVAL_REPORTS    report folder (default eval/reports)
#   EVAL_PUBLIC_DIR HotpotQA and MuSiQue copies (default eval/datasets/public)
#   EVAL_REPEATS    how often bench asks each question (default 3; --repeats overrides it per run)

# Gateway (the only published port, bound to 127.0.0.1)
GATEWAY_PORT=8000
# Largest file you can upload, in MB (the UI sends one file per request)
MAX_UPLOAD_MB=200
# GATEWAY_BIND=127.0.0.1
# The address users open. https://... gives the __Host- Secure cookie; plain http is refused for any host but
# localhost unless AUTH_ALLOW_INSECURE_HTTP=true. Default: http://localhost:${GATEWAY_PORT}
# PUBLIC_ORIGIN=https://rag.example.lan
# A TLS proxy on this host reaches the gateway from the first address of FRONTEND_SUBNET. Trusting it gives
# sign-in limits and the audit log the browser's address (DEPLOYMENT section 5.3). Only while GATEWAY_BIND
# stays 127.0.0.1: on 0.0.0.0, LAN clients arrive from the same address and could fake X-Forwarded-For.
# TRUSTED_PROXY_CIDR=172.31.240.1/32     # default 127.0.0.1/32: trusts no proxy
# FRONTEND_SUBNET=172.31.240.0/24        # change if it clashes with a network on this host

# Sign-in (auth service)
# AUTH_IDLE_TIMEOUT_MIN=720
# AUTH_ABSOLUTE_TIMEOUT_DAYS=7
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_BASE_MIN=15
# AUTH_LOCKOUT_MAX_HOURS=24
# AUTH_IP_FAILURE_LIMIT=20
# AUTH_MIN_PASSWORD_LENGTH=12
# AUTH_TOKEN_MAX_DAYS=365
# An account deletion answers within this many seconds (202 while it goes on); below the gateway's 120 s
# AUTH_ADMIN_DELETE_WAIT_S=60

# LLM served by llama-server from the `models` volume
# LLM_MODEL is only the name llama-server answers to; changing it does not change the model.
LLM_MODEL=qwen3.8-27b
LLM_GGUF=Qwen3.8-27B-UD-Q4_K_XL.gguf
LLM_MMPROJ=mmproj-BF16.gguf
# Total context for the 2 request slots; each request gets half. More context needs more GPU memory.
# compose passes it to rag (RAG_LLM_CTX), which sizes every prompt to fit half of it; if you lower it, also
# lower RAG_THINK_TOKENS (below) so that a Think answer still leaves room for sources.
LLM_CTX=65536

# Optional: folder with gguf/ and hf/ to seed the models volume without downloading
# MODELS_SEED_DIR=/path/to/local-rag-models

# Ingestion and chunking
WORKER_MEM_LIMIT=12g
# INGEST_CHUNK_TARGET_TOKENS=256
# INGEST_CHUNK_MAX_TOKENS=384
# INGEST_TABLE_MAX_TOKENS=512
# INGEST_MAX_ROWS_INDEXED=20000
# INGEST_MAX_FIGURES_PER_DOC=150
# Recycle an idle parser above this RSS (MiB), releasing PDF/native caches before embedding; 0 always recycles
# INGEST_PARSER_CACHE_MB=1024
# A running job's claim lasts this long without renewal (renewed every 10 s); then the worker takes it back
# INGEST_RUN_LEASE_S=90
# After a reindex, the replaced index generation stays readable this long (hours) for questions that started
# on it; then the worker's sweep removes its points and files. 0 removes it at the next sweep (about a minute)
# INGEST_GENERATION_RETAIN_H=24
# Another OpenAI-compatible vision server. It must be on the backend network, which has no internet route.
# INGEST_VISION_URL=http://llm:8080
# Figures: charts are read in two passes (data points, then the description) at temperature 0
# INGEST_CHART_EXTRACTION=true
# INGEST_CHART_EXTRACTION_TOKENS=2000
# INGEST_IMAGE_DESCRIPTION_TOKENS=4000
# INGEST_FIGURE_DESCRIPTION_TOKENS=4000
# INGEST_DESCRIBE_TEMPERATURE=0
# The document summary (a plain paragraph needs about 200); a cut one is retried once with 2.5x the room
# INGEST_SUMMARY_TOKENS=1200
# INGEST_SUMMARY_RETRY_TOKENS=3000
# A cut description is retried once with 1.5x the room, up to this many tokens
# INGEST_RETRY_MAX_TOKENS=8000
# Figure descriptions stop (the rest searchable by caption) after this many failures in a row, or this long
# INGEST_FIGURE_FAILURE_LIMIT=3
# INGEST_FIGURE_DEADLINE_S=3600
# Wait before the one retry of a busy (503), failed (5xx) or timed-out vision or embedding call
# INGEST_RETRY_BACKOFF_S=5
# INGEST_VISION_TIMEOUT_S=600
# INGEST_MODELS_TIMEOUT_S=600
# Every cell of a sheet is also kept as text (<table>__raw) for the deep-search peek tool, up to this many rows
# INGEST_RAW_TABLE_MAX_ROWS=100000
# Tables read from one sheet (a second table below the first becomes "<sheet> (2)"); the rest stay in the last
# INGEST_MAX_TABLES_PER_SHEET=50
# Model replies (figure descriptions, chart data, summaries) are cached per account, keyed on the exact request,
# the prompt version and the model files, so a reindex of unchanged content makes no model call. false turns it
# off (entries already stored are still deleted with their documents and accounts). Change the salt to start
# afresh, for example after changing the llm image or its flags in compose.yaml.
# INGEST_LLM_CACHE=true
# INGEST_LLM_CACHE_MAX_MB=1024
# INGEST_LLM_CACHE_MAX_ENTRIES=200000
# INGEST_LLM_CACHE_TIMEOUT_S=10
# INGEST_LLM_CACHE_MAX_ERRORS=3
# INGEST_LLM_CACHE_SALT=

# SQL sandbox: query time limit, cell and result caps; a query that finds every slot busy for
# SQL_QUEUE_WAIT_S gets 503 (rag retries once). Keep RAG_SQL_TIMEOUT_S at least 2 x SQL_TIMEOUT_S + the wait.
# SQL_TIMEOUT_S=20
# SQL_QUEUE_WAIT_S=5
# SQL_MAX_CELL_CHARS=2000
# SQL_MAX_RESPONSE_CHARS=200000
# Tables files sent to rag for Python runs at once (503 after SQL_QUEUE_WAIT_S)
# SQL_MAX_FILE_STREAMS=2
# One tables file per user at a time; a request waits this long for its place, then gets 503
# SQL_FILE_QUEUE_WAIT_S=20
# RAG_SQL_TIMEOUT_S=60

# Retrieval
# RAG_RRF_K=60
# RAG_WEIGHT_IMAGE=0.5
# RAG_MIN_RELEVANCE=0.05
# RAG_IMAGE_MIN_COSINE=0.30

# Search tasks (DEPLOYMENT section 4.22): the General task's instruction, which the question is embedded after (one
# line, at most 300 characters; empty embeds the bare question). Query side only: recreate rag, no reindex.
# RAG_QUERY_INSTRUCTION=Given a question about the user's documents, retrieve passages with the facts needed to answer it
# Custom search tasks per user (the Search tasks panel); adding one past it is refused
# THREADS_MAX_SEARCH_TASKS=50

# Prompt budget, in the model's tokens (one request slot holds LLM_CTX / 2). rag counts with the Qwen3
# tokenizer.json in the models volume (times a factor: llama-server counts up to 3.4% more), or a
# conservative estimate without it. The sources get what the slot leaves, at most RAG_SOURCE_BUDGET.
# RAG_TOKENIZER_FILE=/models/hf/Qwen3-Embedding-0.6B/tokenizer.json
# RAG_TOKENIZER_FACTOR=1.05
# RAG_PROMPT_MARGIN_TOKENS=512
# RAG_SOURCE_BUDGET=16000
# RAG_SQL_BUDGET=2500
# RAG_ANSWER_TOKENS=4096
# RAG_THINK_TOKENS=8192
# Smaller model calls; a reply cut at its limit is retried once with RAG_RETRY_TOKENS_FACTOR x the room,
# never above RAG_RETRY_MAX_TOKENS
# RAG_PLANNER_TOKENS=600
# RAG_INTENT_TOKENS=600
# RAG_REWRITE_TOKENS=160
# RAG_RETRY_TOKENS_FACTOR=2.5
# RAG_RETRY_MAX_TOKENS=4096
# Wait before the one retry of a busy (503), failed (5xx) or timed-out llm, models or sql call
# RAG_RETRY_BACKOFF_S=2
# RAG_LLM_TIMEOUT_S=900

# Deep search
# RAG_AGENT_MAX_STEPS=10
# RAG_AGENT_VERIFY_ROUNDS=2
# RAG_AGENT_TOKENS=2048
# RAG_AGENT_PREVIEW_CHARS=1000
# RAG_VERIFY_EVIDENCE_TOKENS=16000
# Which implementation runs it: langgraph (rag/agent.py, the default), deepagents (rag/agent_deepagents.py, on
# the deepagents package) or deepagents_stock (that package out of the box). A chat request's "agent" field
# overrides it.
# RAG_DEEP_AGENT=langgraph
# Thinking in the plan and verify steps of either (a request's "deep_think" overrides it), with this much room
# RAG_DEEP_THINK=false
# RAG_DEEP_THINK_TOKENS=4096
# deepagents only: results over RAG_DEEP_EVICT_TOKENS are kept in the request's virtual files (the model
# sees RAG_DEEP_PREVIEW_TOKENS of them); the research prompt is summarized past RAG_DEEP_SUMMARY_TOKENS;
# RAG_DEEP_SUBAGENTS offers a researcher sub-agent; RAG_DEEP_HARNESS_CALLS caps write_todos, read_file, task
# RAG_DEEP_EVICT_TOKENS=2000
# RAG_DEEP_PREVIEW_TOKENS=600
# RAG_DEEP_SUMMARY_TOKENS=20000
# RAG_DEEP_SUMMARY_KEEP_TOKENS=6000
# RAG_DEEP_SUMMARY_INPUT_TOKENS=12000
# RAG_DEEP_SUBAGENTS=false
# RAG_DEEP_HARNESS_CALLS=12

# Exhaustive mode (a chat request's mode "exhaustive", the UI's Read all): every section of the selected
# documents is read in map calls of at most RAG_EXHAUSTIVE_GROUP_TOKENS of passages, RAG_EXHAUSTIVE_CONCURRENCY
# at once (1 or 2: llama-server has two slots), and the notes are merged until they fit RAG_EXHAUSTIVE_NOTES_TOKENS.
# One request reads at most RAG_EXHAUSTIVE_MAX_INPUT_TOKENS and RAG_EXHAUSTIVE_MAX_SECTIONS; past them it stops
# and the answer says what was not read.
# RAG_EXHAUSTIVE_GROUP_TOKENS=8000
# RAG_EXHAUSTIVE_MAP_TOKENS=1500
# RAG_EXHAUSTIVE_CONCURRENCY=1
# RAG_EXHAUSTIVE_MAX_INPUT_TOKENS=300000
# RAG_EXHAUSTIVE_MAX_SECTIONS=500
# RAG_EXHAUSTIVE_NOTES_TOKENS=16000
# RAG_EXHAUSTIVE_REDUCE_TOKENS=4096
# RAG_EXHAUSTIVE_REDUCE_ROUNDS=3

# Python in deep search (DEPLOYMENT section 4.16): the run_python tool for every arm, run by the sandbox service.
# Nothing runs until all three are set: the compose profile, RAG_DEEP_PYTHON and RAG_SANDBOX_URL (in .env, or in
# the shell for one `docker compose up`: the shell wins, and a later plain `up` falls back to .env or off).
#   off      never; a request's "python": true is a 422 (the default)
#   request  only for a request with "python": true (the benchmark's +python variants)
#   on       for every deep search, unless the request sends "python": false
# Each run gets the selected documents' tables and text, at most RAG_SANDBOX_INPUT_MB together (more is refused,
# never cut), and RAG_SANDBOX_TIMEOUT_S (at most SANDBOX_MAX_TIMEOUT_S); the model reads RAG_SANDBOX_RESULT_TOKENS of
# the output. Fair use: RAG_SANDBOX_USER_RUNS runs per user at once, RAG_SANDBOX_REQUEST_SECONDS of run time per
# question, RAG_SANDBOX_TOTAL_INPUT_MB of Python data held by rag for all questions.
# COMPOSE_PROFILES=sandbox
# RAG_DEEP_PYTHON=off
# RAG_SANDBOX_URL=http://sandbox:8008
# RAG_SANDBOX_TIMEOUT_S=120
# RAG_SANDBOX_REQUEST_TIMEOUT_S=600
# RAG_SANDBOX_INPUT_MB=256
# RAG_SANDBOX_CODE_CHARS=20000
# RAG_SANDBOX_RESULT_TOKENS=3000
# RAG_SANDBOX_USER_RUNS=1
# RAG_SANDBOX_REQUEST_SECONDS=600
# RAG_SANDBOX_TOTAL_INPUT_MB=1024
# Data fetches for Python at once (one per user); how long a cancelled run's end is waited for
# RAG_SANDBOX_FETCHES=2
# RAG_SANDBOX_CANCEL_WAIT_S=60
# rag answers /readyz from its last check for this long; rag's memory cap (no model in it: tokenizer and Python data)
# RAG_READY_CACHE_S=5
# RAG_MEM_LIMIT=6g
# The sandbox network's fixed subnet: rag refuses every request from it. Change it if it clashes with a host network.
# SANDBOX_SUBNET=172.31.241.0/24
# The sandbox container (compose.yaml): memory (tmpfs included), CPUs, processes, scratch and /tmp sizes
# SANDBOX_MEMORY=4g
# SANDBOX_CPUS=4
# SANDBOX_PIDS=256
# SANDBOX_SCRATCH_SIZE=2g
# SANDBOX_TMP_SIZE=512m
# SANDBOX_SHM_SIZE=64m
# SysV shared memory in the sandbox's own IPC namespace: the largest segment, and all segments in 4 KiB pages
# SANDBOX_SYSV_SHM_BYTES=67108864
# SANDBOX_SYSV_SHM_PAGES=16384
# One run at a time; a request waits this long for the run before it, then gets "busy"
# SANDBOX_QUEUE_WAIT_S=300
# A cancel (rag's request for a run ended) waits this long for the run's end before it answers
# SANDBOX_CANCEL_WAIT_S=30
# SANDBOX_MAX_TIMEOUT_S=600
# Per run: input files, code, output returned (stdout and stderr each), the largest file it may write, output
# files listed and returned, processes and threads of the sandbox user, open files, threads numpy/polars start
# SANDBOX_MAX_INPUT_MB=512
# SANDBOX_MAX_INPUT_FILES=64
# SANDBOX_MAX_CODE_KB=256
# SANDBOX_MAX_OUTPUT_KB=256
# SANDBOX_MAX_FILE_MB=256
# SANDBOX_MAX_FILES=50
# SANDBOX_MAX_RETURN_FILE_KB=64
# SANDBOX_MAX_RETURN_KB=256
# SANDBOX_MAX_PROCESSES=128
# SANDBOX_MAX_OPEN_FILES=1024
# SANDBOX_THREADS=4
# Schema cards (planner, describe_table, list_tables) and the peek and profile_column tools, in tokens
# RAG_SCHEMA_CARD_TOKENS=6000
# RAG_LIST_TABLES_TOKENS=3000
# RAG_PEEK_COLUMNS=30
# RAG_PEEK_TOKENS=4000
# RAG_PROFILE_TOKENS=1500
# Value structure in profile_column: for a text column whose values mostly contain a separator, every distinct
# last part with its count while there are at most this many (else the 30 most frequent and how many more), and
# its size in tokens
# RAG_PROFILE_PARTS_MAX=150
# RAG_PROFILE_PARTS_TOKENS=2000
# Total rows in describe_table and profile_column: a text column with at most this many
# distinct values is summed per value (up to this many text columns per table; 0 marks totals by name only), and a
# value whose sum matches the others' within this share is named as a possible total
# RAG_TOTALS_LABELS_MAX=500
# RAG_TOTALS_COLUMNS=4
# RAG_TOTALS_TOLERANCE=0.005
# Thread compaction folds at most this many of the oldest turns, within this many tokens, per run
# RAG_SUMMARY_FOLD_MESSAGES=24
# RAG_SUMMARY_FOLD_TOKENS=12000
