server {
    listen ${PROXY_PORT};
    server_name _;
    client_max_body_size 64m;
    access_log off;

    location / {
        proxy_pass ${PROXY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
